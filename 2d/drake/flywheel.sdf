<?xml version="1.0"?>
<sdf version="1.9">
  <model name="flywheel_model">
    <static>false</static>

    <link name="flywheel">

      <!-- Mass in kg; inertia in kg·m².
           The wheel's spin axis is local Y. -->
      <inertial>
        <mass>0.160773517322</mass>

        <inertia>
          <ixx>0.000242192743</ixx>
          <iyy>0.000481838231</iyy>
          <izz>0.000242192743</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="wheel_visual">
        <!-- Rotate an XY mesh into XZ, with its axis along +Y.
             Pose: x y z roll pitch yaw; angles in radians. -->
        <pose>0 0 0 -1.570796326795 0 0</pose>

        <geometry>
          <mesh>
            <uri>meshes/flywheel.obj</uri>
          </mesh>
        </geometry>

        <material>
          <diffuse>0.8 0.55 0.12 1</diffuse>
        </material>
      </visual>

    </link>
  </model>
</sdf>